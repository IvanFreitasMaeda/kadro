{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadro",
  "version": "0.2.0",
  "identifier": "io.github.ivanfreitasmaeda.kadro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' kadro: http://kadro.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Captura de tela rápida",
    "longDescription": "Kadro captura a tela inteira ou uma área com um clique ou atalho, e copia ou salva a imagem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0N0M2ODA3RUE1NjE1RjAKUldUd0ZWYnFCMmg4QkcvL0Mrbm9xbEwzZUpzWlRYRUxpRlUxV21VKytPL2NDclFobitLc1ozd1oK",
      "endpoints": [
        "https://github.com/IvanFreitasMaeda/kadro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
