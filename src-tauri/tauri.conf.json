{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadro",
  "version": "1.0.0",
  "identifier": "io.github.ivanfreitasmaeda.kadro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' kadro: http://kadro.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Captura de tela rápida",
    "longDescription": "Kadro captura a tela inteira ou uma área com um clique ou atalho, anota, grava em MP4 ou GIF, copia texto de imagens e guarda o histórico da área de transferência.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0 | libpipewire-0.3-0t64"
        ],
        "recommends": [
          "tesseract-ocr",
          "tesseract-ocr-por",
          "xdg-desktop-portal"
        ],
        "desktopTemplate": "linux/kadro.desktop",
        "section": "graphics"
      },
      "rpm": {
        "depends": [
          "pipewire-libs"
        ],
        "recommends": [
          "tesseract",
          "tesseract-langpack-por",
          "xdg-desktop-portal"
        ],
        "desktopTemplate": "linux/kadro.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2RDQ0ODBCRUVCRTQ0Q0EKUldUS1JMN3VDMGpVSm9zTVR2eTNGNm5zYWhyd2ZBa0FtMllmcnMrcXBhbmJ4N1haWHNWSE5YbWcK",
      "endpoints": [
        "https://github.com/IvanFreitasMaeda/kadro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
