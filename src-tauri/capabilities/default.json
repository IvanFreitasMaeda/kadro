{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Permissions for the capture overlays, the preferences window and the gallery",
  "windows": [
    "overlay-*",
    "settings",
    "gallery"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
